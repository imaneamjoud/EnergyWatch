                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass Utilisateur {\n    +UUID idUtilisateur\n    +String nom\n    +String email\n    +String motDePasse\n    +Role role\n    +seConnecter()\n    +consulterDashboard()\n}\n\nclass Role {\n    &lt;&lt;enumeration&gt;&gt;\n    ADMINISTRATEUR\n    UTILISATEUR\n}\n\nclass Dispositif {\n    +UUID idDispositif\n    +String nom\n    +String description\n    +String statut\n    +Date dateCreation\n    +consulterMesures()\n}\n\nclass MesureEnergetique {\n    +UUID idMesure\n    +Float tension\n    +Float courant\n    +Float puissance\n    +Float energie\n    +DateTime horodatage\n}\n\nclass Alerte {\n    +UUID idAlerte\n    +String type\n    +String message\n    +Float seuil\n    +DateTime dateAlerte\n    +String statut\n    +verifierSeuil()\n    +marquerCommeLue()\n}\n\nclass SimulateurMesures {\n    +Boolean actif\n    +Integer intervalle\n    +genererMesure()\n    +calculerPuissance()\n    +calculerEnergie()\n    +demarrerSimulation()\n    +arreterSimulation()\n}\n\nclass ConfigurationSimulation {\n    +UUID idConfiguration\n    +Float puissanceMin\n    +Float puissanceMax\n    +Integer intervalle\n    +String modeSimulation\n    +modifierConfiguration()\n}\n\nUtilisateur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Dispositif : gere\nUtilisateur --&gt; Role : possede\n\nDispositif \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MesureEnergetique : produit\nDispositif \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Alerte : declenche\n\nAlerte \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; MesureEnergetique : concerne\n\nSimulateurMesures ..&gt; MesureEnergetique : genere\nSimulateurMesures ..&gt; Dispositif : simule\nSimulateurMesures \&quot;1\&quot; --&gt; \&quot;1\&quot; ConfigurationSimulation : utilise\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="WBBpia6hWzMvH2MmoeAH-295">
