            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass Utilisateur {\n    +UUID idUtilisateur\n    +String nomComplet\n    +String email\n    +String motDePasse\n    +Role role\n    +Boolean actif\n    +seConnecter()\n    +seDeconnecter()\n    +modifierProfil()\n}\n\nclass Role {\n    &lt;&lt;enumeration&gt;&gt;\n    ADMIN\n    ANALYSTE\n    GESTIONNAIRE\n}\n\nclass Batiment {\n    +UUID idBatiment\n    +String nom\n    +String adresse\n    +String type\n    +ajouterCompteur()\n    +modifierBatiment()\n    +consulterConsommation()\n}\n\nclass Compteur {\n    +UUID idCompteur\n    +String reference\n    +String emplacement\n    +String etat\n    +Date dateInstallation\n    +activer()\n    +desactiver()\n    +envoyerMesure()\n}\n\nclass Mesure {\n    +UUID idMesure\n    +DateTime horodatage\n    +Date dateMesure\n    +Double consommation\n    +String unite\n    +enregistrerMesure()\n    +consulterHistorique()\n}\n\nclass Anomalie {\n    +UUID idAnomalie\n    +DateTime dateDetection\n    +String typeAnomalie\n    +String description\n    +String gravite\n    +String statut\n    +detecterAnomalie()\n    +modifierStatut()\n    +ajouterCommentaire()\n}\n\nclass RegleAlerte {\n    +UUID idRegle\n    +String nom\n    +Double seuil\n    +String condition\n    +Boolean active\n    +verifierSeuil()\n    +modifierRegle()\n}\n\nclass Recommandation {\n    +UUID idRecommandation\n    +String titre\n    +String description\n    +Date dateCreation\n    +String statut\n    +genererRecommandation()\n    +modifierStatut()\n}\n\nclass Rapport {\n    +UUID idRapport\n    +String titre\n    +Date dateGeneration\n    +String periode\n    +String format\n    +genererRapport()\n    +exporterRapport()\n}\n\nclass Notification {\n    +UUID idNotification\n    +String message\n    +DateTime dateCreation\n    +Boolean estLue\n    +envoyerNotification()\n    +marquerCommeLue()\n}\n\nclass Affectation {\n    +UUID idAffectation\n    +Date dateAffectation\n}\n\nUtilisateur --&gt; Role : possède\nBatiment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Compteur : contient\nCompteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Mesure : produit\nBatiment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; RegleAlerte : possède\nCompteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Anomalie : concerne\nMesure \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Anomalie : permet de détecter\nBatiment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Anomalie : contient\nBatiment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Recommandation : reçoit\nAnomalie \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Recommandation : peut générer\nUtilisateur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Rapport : génère\nUtilisateur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : reçoit\nUtilisateur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Affectation : possède\nBatiment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Affectation : est affecté\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="UFsfhERY-51CLaUD5z1B-1">
